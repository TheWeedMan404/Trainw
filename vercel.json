{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node env-config.js",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/role", "destination": "/tw-role.html" },
    { "source": "/login", "destination": "/tw-login.html" },
    { "source": "/admin", "destination": "/tw-gym-acc.html" },
    { "source": "/dashboard", "destination": "/tw-gym-acc.html" },
    { "source": "/dashboard/gym", "destination": "/tw-gym-acc.html" },
    { "source": "/dashboard/coach", "destination": "/tw-coach-acc.html" },
    { "source": "/dashboard/client", "destination": "/tw-client-acc.html" },
    { "source": "/coach", "destination": "/tw-coach-acc.html" },
    { "source": "/client", "destination": "/tw-client-acc.html" },
    { "source": "/gate", "destination": "/gate-terminal.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
